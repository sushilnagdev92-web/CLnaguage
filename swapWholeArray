import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        int[] arr = {10, 20, 30, 40 ,50, 60};
        int num = arr.length-1;


        for(int i = 0 ; i < arr.length/2; i++){
            int temp = arr[i];
            arr[i] = arr[num-i];
            arr[num-i] = temp;

        }

        for( int j =0 ; j<arr.length; j++){
            System.out.println(arr[j]);
        }

    }

}
